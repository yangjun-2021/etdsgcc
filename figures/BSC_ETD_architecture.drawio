        <mxCell id="conformal_gate" value="&lt;b&gt;第一层：边际共形预测门控&lt;/b&gt;&lt;br&gt;Split Conformal Prediction&lt;br&gt;alpha = 0.10（名义覆盖率90%）&lt;br&gt;实证覆盖率 approx 90.0%&lt;br&gt;条件精度 0.9950&lt;br&gt;&lt;font size=&quot;9&quot; color=&quot;#666666&quot;&gt;高置信样本自动放行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=11;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="80" y="670" width="220" height="85" as="geometry" />
        </mxCell>
        
        <mxCell id="topk_review" value="&lt;b&gt;第二层：错误风险排序（Top-K审查）&lt;/b&gt;&lt;br&gt;低置信度样本按审查优先级降序排列&lt;br&gt;Top-1%稽查：精确率 1.000&lt;br&gt;Top-2%稽查：召回率 23.5%&lt;br&gt;&lt;font size=&quot;9&quot; color=&quot;#666666&quot;&gt;资源受限下的高风险用户精准稽查&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#E64A19;strokeWidth=2;fontSize=11;fontFamily=SimSun;" vertex="1" parent="1">
          <mxGeometry x="340" y="670" width="280" height="85" as="geometry" />
        </mxCell>
        
        <mxCell id="sel_out" value="&lt;b&gt;选择性分类输出&lt;/b&gt;&lt;br&gt;• 高置信自动判别（~90%样本）&lt;br&gt;• 中置信分级审查队列&lt;br&gt;• 低置信人工稽查优先&lt;br&gt;&lt;font size=&quot;9&quot; color=&quot;#666666&quot;&gt;Selective Classification Output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3E5FC;strokeColor=#0288D1;strokeWidth=2;fontSize=11;fontFamily=SimSun;" vertex="1" parent="1">
