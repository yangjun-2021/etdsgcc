        <mxCell id="stage4_label" value="&lt;b&gt;阶段4  双层选择性分类&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;10&quot; color=&quot;#666666&quot;&gt;Stage 4: Bi-level Selective Classification&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontFamily=SimHei;" vertex="1" parent="1">
